    {
        "id": "4f64e85dc8659e31",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Separar sensores",
        "func": "const partes = String(msg.payload).split(\"|\");\n\nconst t = Number(partes[1]);\nconst h = Number(partes[3]);\nconst l = Number(partes[5]);\n\nreturn [\n    { payload: t },\n    { payload: h },\n    { payload: l }\n];",
