    {
        "id": "d4aa80ddb0bafd65",
        "type": "function",
        "z": "f6f2187d.f17ca8",
        "name": "Preparar Smart Data Model",
        "func": "\nconst partes = String(msg.payload).split(\"|\");\n\nconst temperatura = Number(partes[1]);\nconst umidade = Number(partes[3]);\nconst ldr = Number(partes[5]);\n\nif (\n    !Number.isFinite(temperatura) ||\n    !Number.isFinite(umidade) ||\n    !Number.isFinite(ldr)\n) {\n    node.warn(\"Formato de mensagem inválido: \" + msg.payload);\n    return null;\n}\n\nconst instante = partes[7];\n\nmsg.method = \"PATCH\";\nmsg.url = \"http://172.17.0.1:1026/v2/entities/urn:ngsi-ld:IndoorEnvironmentObserved:adega-demo/attrs?options=upsert\";\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\",\n    \"fiware-service\": \"openiot\",\n    \"fiware-servicepath\": \"/\"\n};\n\nmsg.payload = {\n    temperature: {\n        type: \"Number\",\n        value: temperatura\n    },\n    relativeHumidity: {\n        type: \"Number\",\n        value: umidade / 100\n    },\n    dateObserved: {\n        type: \"DateTime\",\n        value: instante || new Date().toISOString()\n    }\n};\n\nnode.warn(\"Payload preparado: \" + JSON.stringify(msg.payload));\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 380,
        "wires": [
            [
                "ee3c34bd7438fbe6"
            ]
        ]
